PORT=3000

# Your domain — used for CORS (set after you deploy)
CLIENT_URL=https://yourdomain.com

# MySQL — copy values from Hostinger hPanel > Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=court_masters

# JWT — generate two long random strings (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh_tokens_64_chars
JWT_REFRESH_EXPIRES_IN=7d
